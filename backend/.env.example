DATABASE_URL="postgresql://dautu:dautu@localhost:5434/dautu?schema=public"
JWT_SECRET="doi-chuoi-nay-khi-chay-that"
PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"

# Cách 1: điền key lấy tại https://platform.claude.com
# Cách 2: bỏ trống dòng dưới và chạy `ant auth login` — SDK tự dùng profile đó
# LLM_API_KEY=""
# Model mặc định cho mọi việc dùng AI
LLM_MODEL="claude-opus-5-5"
# (tuỳ chọn) Model riêng từng việc — bỏ trống thì dùng LLM_MODEL
# Chat cố vấn: cần suy luận nhiều bước, nên dùng model mạnh nhất
LLM_MODEL_ADVISOR=""
# Bản tin sáng / tổng kết phiên: model khá trở lên
LLM_MODEL_BRIEF=""
# Đọc & gắn nhãn tin, viết lời nhắn thông báo: model nhanh, rẻ
LLM_MODEL_FAST=""

# Router bên thứ ba có endpoint chuẩn Anthropic (vd 9router). Ghi base URL KHÔNG kèm /v1
# vì SDK tự nối /v1/messages. Có base URL thì tự bật chế độ tương thích
# (tắt web search, fallbacks, adaptive thinking); ép bằng ADVISOR_COMPAT_MODE=true|false.
# LLM_BASE_URL=""
# ADVISOR_COMPAT_MODE=""

# Đăng nhập Google: OAuth Client ID (loại "Web application") tạo tại
# https://console.cloud.google.com/apis/credentials — thêm http://localhost:5173 vào Authorized JavaScript origins
GOOGLE_CLIENT_ID=""

# MiniMax: công cụ tìm kiếm web cho cố vấn khi chạy qua router bên thứ ba (API search của MiniMax).
# Không có thì cố vấn chỉ dùng tin RSS. Dùng API Anthropic chính thức thì không cần (đã có web_search).
MINIMAX_API_KEY=""
