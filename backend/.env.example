DATABASE_URL="postgresql://dautu:dautu@localhost:5434/dautu?schema=public"
JWT_SECRET="doi-chuoi-nay-khi-chay-that"
PORT=3000
FRONTEND_ORIGIN="http://localhost:5173"

# Cách 1: điền key lấy tại https://platform.claude.com
# Cách 2: bỏ trống dòng dưới và chạy `ant auth login` — SDK tự dùng profile đó
# LLM_API_KEY=""
# Model mặc định cho mọi việc dùng AI
LLM_MODEL="claude-opus-5-5"
# (tuỳ chọn) Model riêng từng việc — bỏ trống thì dùng LLM_MODEL
# Chat cố vấn: cần suy luận nhiều bước, nên dùng model mạnh nhất
LLM_MODEL_ADVISOR=""
# Bản tin sáng / tổng kết phiên: model khá trở lên
LLM_MODEL_BRIEF=""
# Đọc & gắn nhãn tin, viết lời nhắn thông báo: model nhanh, rẻ
LLM_MODEL_FAST=""

# Router bên thứ ba có endpoint chuẩn Anthropic (vd 9router). Ghi base URL KHÔNG kèm /v1
# vì SDK tự nối /v1/messages. Có base URL thì tự bật chế độ tương thích
# (tắt web search, fallbacks, adaptive thinking); ép bằng ADVISOR_COMPAT_MODE=true|false.
# LLM_BASE_URL=""
# ADVISOR_COMPAT_MODE=""

# Đăng nhập Google: OAuth Client ID (loại "Web application") tạo tại
# https://console.cloud.google.com/apis/credentials — thêm http://localhost:5173 vào Authorized JavaScript origins
GOOGLE_CLIENT_ID=""

# MiniMax: công cụ tìm kiếm web cho cố vấn khi chạy qua router bên thứ ba (API search của MiniMax).
# Không có thì cố vấn chỉ dùng tin RSS. Dùng API Anthropic chính thức thì không cần (đã có web_search).
MINIMAX_API_KEY=""

# Telegram (tuỳ chọn): tạo bot với @BotFather rồi dán token. Bỏ trống = tắt gửi Telegram
TELEGRAM_BOT_TOKEN=""
# Địa chỉ web công khai để link trong tin Telegram mở đúng trang (mặc định dùng FRONTEND_ORIGIN)
APP_URL=""
# Đặt false nếu chạy nhiều instance: chỉ một instance được nhận lệnh từ bot
TELEGRAM_POLLING="true"

# Giới hạn tốc độ gọi nguồn Vietcap / DNSE (tuỳ chọn; mặc định trading 10 req/s - 8 đồng thời, iq 5 req/s - 4 đồng thời, dnse 5 req/s - 4 đồng thời).
# Vượt giới hạn thì request xếp hàng chứ không bị bỏ. Biến: VIETCAP_{TRADING|IQ|DNSE}_RPS và VIETCAP_{TRADING|IQ|DNSE}_CONCURRENCY
# VIETCAP_IQ_RPS=5
# VIETCAP_IQ_CONCURRENCY=4

# Tìm kiếm tin tức bằng OpenSearch (tuỳ chọn). Bỏ trống = tìm toàn văn trên PostgreSQL (bảng NewsArticle, vẫn tô sáng).
# Server: endpoint của Amazon OpenSearch Service (bật fine-grained access control, dùng master user).
# Local: `docker compose --profile search up -d` rồi đặt OPENSEARCH_URL="http://localhost:9201", không cần tài khoản.
# Worker lưu tin vào PostgreSQL rồi đưa sang index mỗi 5 phút, giữ 180 ngày; index mới thì nạp lại cả kho từ DB.
OPENSEARCH_URL=""
OPENSEARCH_USERNAME=""
OPENSEARCH_PASSWORD=""
# OPENSEARCH_NEWS_INDEX="dautu-news-v1"
