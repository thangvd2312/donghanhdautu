generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  /// null với tài khoản chỉ đăng nhập bằng Google
  passwordHash        String?
  /// "sub" trong ID token của Google
  googleId            String?               @unique
  avatarUrl           String?
  name                String
  createdAt           DateTime              @default(now())
  profile             InvestorProfile?
  holdings            Holding[]
  watchlist           WatchItem[]
  conversations       Conversation[]
  notifications       Notification[]
  priceAlerts         PriceAlert[]
  feedback            AnswerFeedback[]
  transactions        Transaction[]
  plans               InvestmentPlan[]
  importBatches       ImportBatch[]
  goals               Goal[]
  telegram            TelegramLink?
  pushSettings        PushSettings?
  pushSubscriptions   PushSubscription[]
  portfolios          Portfolio[]
  briefRuns           BriefRun[]
  dismissedActions    DismissedAction[]
  eventReminder       EventReminderSetting?
  savedScreens        SavedScreen[]
  paperAccount        PaperAccount?
  portfolioAlertRules PortfolioAlertRule[]
  tipChecks           TipCheck[]
}

/// Kết quả bài khảo sát tính cách đầu tư lúc onboarding
model InvestorProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Câu trả lời thô, giữ lại để giải thích vì sao ra kiểu nhà đầu tư này
  answers           Json
  /// 0-100, càng cao càng chịu được rủi ro
  riskScore         Int
  /// conservative | balanced | growth | aggressive
  riskType          String
  /// preserve | accumulate | trade
  goal              String
  /// short (<1 năm) | medium (1-3 năm) | long (>3 năm)
  horizon           String
  /// % lỗ tối đa chịu được trước khi muốn bán
  maxDrawdownPct    Int
  /// Người dùng tự nhận hay mua theo đám đông / hội nhóm
  fomoProne         Boolean
  /// % thay đổi giá trong ngày để bắn cảnh báo cho tài sản đang nắm giữ
  alertThresholdPct Float    @default(3)
  /// Bản tin sáng 8:30 (thứ 2–6)
  morningBrief      Boolean  @default(true)
  /// Tổng kết cuối phiên 15:10 (thứ 2–6)
  closingBrief      Boolean  @default(true)
  /// Tổng kết tuần, sáng thứ 7
  weeklyBrief       Boolean  @default(true)
  /// Bản tin coin mỗi giờ (cả cuối tuần), chỉ gửi khi đang giữ / theo dõi coin
  cryptoBrief       Boolean  @default(true)
  /// Cảnh báo tin vĩ mô quan trọng, biến động tỷ giá
  macroAlerts       Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model Holding {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// stock | crypto | gold | cash
  assetType String
  /// Mã: FPT, BTCUSDT, BTSJC (mã vàng theo nguồn), VND
  symbol    String
  /// Số lượng: cổ phiếu, coin, lượng vàng (1 lượng = 10 chỉ), số tiền
  quantity  Float
  /// Giá vốn trung bình, VND (coin: USDT)
  avgCost   Float
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model WatchItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetType String
  symbol    String
  createdAt DateTime @default(now())

  @@unique([userId, assetType, symbol])
}

model Conversation {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([userId])
}

/// Lưu nguyên khối content của Claude (kể cả thinking / tool_use / tool_result)
/// để gửi lại y nguyên ở lượt sau — lịch sử chỉ được nối thêm, không sửa.
model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role           String
  content        Json
  /// false cho các message nội bộ (tool_result) không cần hiển thị
  visible        Boolean      @default(true)
  /// Thông tin ngoài nội dung gửi cho model, vd kết quả tự động đối chiếu nguồn của câu trả lời
  meta           Json?
  createdAt      DateTime     @default(now())
  seq            Int          @default(autoincrement())

  @@index([conversationId, seq])
}

model Notification {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// price_move | news | macro
  kind             String
  /// info | warning | critical
  severity         String
  title            String
  body             String
  /// [{title, url}]
  sources          Json
  /// Khoá chống bắn trùng: cùng sự kiện chỉ báo 1 lần / user
  dedupeKey        String
  /// Đường dẫn trong app để xem chi tiết (vd. cuộc trò chuyện chứa bản tin)
  link             String?
  read             Boolean           @default(false)
  createdAt        DateTime          @default(now())
  telegramDelivery TelegramDelivery?
  pushDelivery     PushDelivery?

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  /// Web đọc thông báo mới do worker tạo để đẩy xuống socket (truy vấn theo createdAt)
  @@index([createdAt])
}

/// Cảnh báo khi giá chạm mốc người dùng tự đặt; bắn 1 lần rồi tự tắt
model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// stock | crypto | gold
  assetType   String
  symbol      String
  /// above (giá ≥ mốc) | below (giá ≤ mốc)
  direction   String
  /// Mốc giá theo đơn vị gốc: VND/cp, USDT/coin, VND/lượng (giá bán ra)
  targetPrice Float
  note        String?
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([active])
  @@index([userId])
}

/// Kết quả AI đọc tin: bài nói về mã nào, có phải tin vĩ mô quan trọng không
model NewsTag {
  url         String   @id
  title       String
  tickers     String[]
  /// 0 = không phải tin vĩ mô; 1–5 = mức quan trọng với nhà đầu tư cá nhân
  macroScore  Int      @default(0)
  /// lai_suat | ty_gia | chinh_sach | thue | vang | thi_truong | khac
  topic       String?
  /// Một câu tóm tắt tác động
  impact      String?
  publishedAt DateTime
  taggedAt    DateTime @default(now())

  @@index([publishedAt])
}

/// Kho tin (chứng khoán / vĩ mô từ RSS báo Việt, tin coin), giữ 180 ngày. Là kho gốc của tìm tin: OpenSearch dựng lại
/// từ đây, và khi OpenSearch lỗi thì tìm toàn văn ngay trên bảng này (cột searchVector).
model NewsArticle {
  url          String                   @id
  title        String
  summary      String
  source       String
  category     String
  /// stock | coin
  kind         String
  /// vi | en
  lang         String
  /// Mã cổ phiếu / coin gắn với tin, chữ hoa
  tickers      String[]
  /// 0 = thường; 1–5 = mức quan trọng với nhà đầu tư cá nhân (macroScore của bộ gắn nhãn tin)
  importance   Int                      @default(0)
  publishedAt  DateTime
  /// Tiêu đề + mã (trọng số A) và tóm tắt (B), đã bỏ dấu, cấu hình 'simple'; app ghi cùng lúc với nội dung
  searchVector Unsupported("tsvector")?
  firstSeenAt  DateTime                 @default(now())
  /// Lần nội dung đổi gần nhất
  updatedAt    DateTime
  /// Lần đưa sang OpenSearch gần nhất; null hoặc cũ hơn updatedAt = cần đưa lại
  indexedAt    DateTime?

  @@index([publishedAt])
  @@index([kind, publishedAt])
  @@index([searchVector], type: Gin)
}

/// Số liệu vĩ mô tham chiếu lấy trực tiếp từ nguồn chính thức (NHNN, Fed…), có kiểm tra hợp lệ
model MacroFact {
  key           String   @id
  label         String
  /// Giá trị hiển thị (có thể là khoảng, vd "3,75–4,00")
  value         String
  numericValue  Float?
  unit          String
  /// Ngày của số liệu theo nguồn (ngày áp dụng / kỳ báo cáo)
  asOf          String
  /// Văn bản gốc nếu có, vd "1123/QĐ-NHNN ngày 16/06/2023"
  document      String?
  note          String?
  sourceName    String
  sourceUrl     String
  /// Lần cuối đọc thành công từ nguồn
  fetchedAt     DateTime
  /// Lần cuối giá trị thay đổi
  changedAt     DateTime
  previousValue String?
}

model MacroFactHistory {
  id        String   @id @default(cuid())
  key       String
  value     String
  asOf      String
  sourceUrl String
  fetchedAt DateTime @default(now())

  @@index([key, fetchedAt])
}

/// Người dùng báo một câu trả lời của cố vấn là sai / chưa tốt. Dùng để bổ sung bộ câu hỏi chấm điểm (eval).
model AnswerFeedback {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  /// id message đầu tiên của câu trả lời bị báo
  answerId       String
  /// wrong_number | wrong_source | outdated | bad_advice | other
  reason         String
  note           String?
  /// Câu hỏi và câu trả lời tại thời điểm báo (giữ lại kể cả khi cuộc trò chuyện bị xoá)
  question       String
  answer         String
  /// open | reviewed | added_to_eval
  status         String   @default("open")
  createdAt      DateTime @default(now())

  @@unique([userId, answerId])
  @@index([status, createdAt])
}

/// Sổ giao dịch: nguồn gốc của số dư tài sản và tiền mặt. Bảng Holding được tính lại từ sổ này.
/// Không xoá cứng: huỷ = đặt deletedAt; mọi lần sửa/huỷ lưu bản trước vào TransactionRevision.
model Transaction {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// opening (số dư đầu kỳ) | buy | sell | deposit | withdraw | dividend | fee
  type          String
  /// Ngày giao dịch theo lịch VN
  date          DateTime              @db.Date
  /// stock | crypto | gold | cash; null với nạp / rút / phí
  assetType     String?
  /// FPT, BTCUSDT, SJL1L10, VND/USDT (tiền mặt đầu kỳ)
  symbol        String?
  quantity      Decimal?              @db.Decimal(30, 10)
  /// Giá mỗi đơn vị theo đồng tiền của giao dịch
  price         Decimal?              @db.Decimal(30, 10)
  /// Số tiền với nạp / rút / cổ tức / phí
  amount        Decimal?              @db.Decimal(30, 10)
  fee           Decimal               @default(0) @db.Decimal(30, 10)
  tax           Decimal               @default(0) @db.Decimal(30, 10)
  /// VND | USDT
  currency      String
  /// Số VND cho 1 USDT lúc giao dịch, nếu người dùng nhập
  fxRate        Decimal?              @db.Decimal(30, 10)
  note          String?
  /// Danh mục / tài khoản chứa giao dịch (sổ được kiểm tra riêng cho từng danh mục)
  portfolioId   String?
  portfolio     Portfolio?            @relation(fields: [portfolioId], references: [id])
  /// manual | migration | csv
  source        String                @default("manual")
  importBatchId String?
  importBatch   ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  revisions     TransactionRevision[]
  /// Nhật ký quyết định (FREE-08), tuỳ chọn: lý do (plan | dca | price_level | thesis_changed | rebalance | need_cash | news | tip)
  reason        String?
  /// Cảm xúc lúc quyết định: calm | confident | unsure | anxious | fomo | fear | greedy
  emotion       String?
  /// Kế hoạch người dùng gắn giao dịch vào (cùng tài sản); null = giao dịch không theo kế hoạch nào
  planId        String?
  plan          InvestmentPlan?       @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([importBatchId])
  @@index([portfolioId])
  @@index([planId])
}

model TransactionRevision {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// update | delete
  action        String
  /// Bản ghi trước khi thay đổi
  before        Json
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

/// Kế hoạch đầu tư cho một tài sản (đang giữ hoặc đang theo dõi): người dùng tự đặt, AI chỉ hỗ trợ viết nháp
model InvestmentPlan {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// stock | crypto | gold
  assetType       String
  symbol          String
  /// Luận điểm: vì sao mua / nắm giữ
  thesis          String
  /// Dự định nắm giữ bao lâu, vd "1–3 năm"
  horizon         String?
  /// Điều kiện cho thấy luận điểm sai / cần xem lại hoặc bán
  exitConditions  String
  /// Mốc chốt lời / cắt lỗ theo đơn vị giá gốc (VND/cp, USDT/coin, VND/lượng giá mua vào)
  targetPrice     Float?
  stopPrice       Float?
  /// Chu kỳ xem lại (ngày) để tự đặt ngày xem lại tiếp theo
  reviewEveryDays Int?
  nextReviewAt    DateTime      @db.Date
  /// active | closed
  status          String        @default("active")
  closedReason    String?
  closedAt        DateTime?
  /// Ngày xem lại đã nhắc gần nhất, để không nhắc trùng
  remindedFor     DateTime?     @db.Date
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  versions        PlanVersion[]
  reviews         PlanReview[]
  transactions    Transaction[]

  @@index([userId, status])
  @@index([status, nextReviewAt])
}

/// Bản trước của kế hoạch, lưu mỗi lần sửa
model PlanVersion {
  id        String         @id @default(cuid())
  planId    String
  plan      InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  snapshot  Json
  createdAt DateTime       @default(now())

  @@index([planId])
}

/// Một lần xem lại kế hoạch: quyết định giữ / điều chỉnh / kết thúc và lý do
model PlanReview {
  id             String         @id @default(cuid())
  planId         String
  plan           InvestmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// keep | adjust | close
  decision       String
  note           String?
  /// Dữ kiện lúc xem lại (để đối chiếu sau này)
  priceAtReview  Float?
  pnlPctAtReview Float?
  /// Nhật ký quyết định (FREE-08), tuỳ chọn: cùng bộ lý do / cảm xúc với Transaction
  reason         String?
  emotion        String?
  createdAt      DateTime       @default(now())

  @@index([planId])
}

/// Một lần nhập giao dịch từ file CSV. Cùng nội dung (hash) chỉ nhập một lần; hoàn tác = huỷ mọi giao dịch của đợt
model ImportBatch {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Băm nội dung các dòng sẽ nhập (đã chuẩn hoá) để bấm lại / gửi lại không tạo trùng
  hash          String
  fileName      String?
  rowCount      Int
  importedCount Int
  portfolioId   String?
  undoneAt      DateTime?
  createdAt     DateTime      @default(now())
  transactions  Transaction[]

  @@index([userId, hash])
}

/// Giá đóng cửa theo ngày (lịch VN) để dựng lịch sử tài sản. fx/USDTVND: tỷ giá USDT
model PriceDaily {
  /// stock | crypto | gold | fx
  assetType String
  symbol    String
  date      DateTime @db.Date
  /// VND/cp, USDT/coin, VND/lượng (giá mua vào), VND/USDT
  close     Float
  source    String
  createdAt DateTime @default(now())

  @@id([assetType, symbol, date])
}

/// Mục tiêu tài chính: số tiền đích, ngày đích, tài sản được gán (theo %), tỷ trọng mong muốn
model Goal {
  id                  String           @id @default(cuid())
  userId              String
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  /// VND
  targetAmount        Float
  targetDate          DateTime         @db.Date
  /// Dự định góp thêm mỗi tháng (VND)
  monthlyContribution Float            @default(0)
  /// Lợi suất năm GIẢ ĐỊNH để mô phỏng (%), không phải cam kết
  expectedReturnPct   Float            @default(6)
  /// Tỷ trọng mong muốn theo loại tài sản, vd {"stock":50,"gold":20,"cash":30}; tổng 100
  targetAllocation    Json?
  /// active | paused | achieved
  status              String           @default("active")
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  allocations         GoalAllocation[]

  @@index([userId])
}

/// Phần trăm của một tài sản được gán cho mục tiêu. Tổng % của một tài sản qua mọi mục tiêu ≤ 100
model GoalAllocation {
  id        String @id @default(cuid())
  goalId    String
  goal      Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// stock | crypto | gold | cash
  assetType String
  symbol    String
  pct       Float

  @@unique([goalId, assetType, symbol])
}

/// Liên kết Telegram do người dùng chủ động tạo (bấm Start với mã một lần). Không có liên kết = không gửi gì ra ngoài
model TelegramLink {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId      String   @unique
  username    String?
  active      Boolean  @default(true)
  /// Loại thông báo được gửi: {"price_move":true,"price_target":true,"news":false,...}
  kinds       Json
  /// Giờ yên lặng theo giờ VN, phút trong ngày (vd 1320 = 22:00); null = không đặt
  quietStart  Int?
  quietEnd    Int?
  /// false: chỉ gửi tiêu đề chung + link, không gửi nội dung chi tiết (có thể chứa số liệu danh mục)
  showDetails Boolean  @default(false)
  linkedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Mã một lần để liên kết Telegram (t.me/<bot>?start=<code>), hết hạn sau 15 phút
model TelegramLinkCode {
  code      String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

/// Hàng đợi gửi Telegram: mỗi thông báo tối đa một lần gửi (unique), có thử lại và trạng thái
model TelegramDelivery {
  id             String       @id @default(cuid())
  userId         String
  notificationId String       @unique
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  /// pending | sending | sent | failed | skipped
  status         String       @default("pending")
  attempts       Int          @default(0)
  lastError      String?
  nextAttemptAt  DateTime     @default(now())
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, nextAttemptAt])
  @@index([userId, sentAt])
}

/// Cài đặt chung của ứng dụng dạng key–value (vd khoá VAPID cho Web Push tự tạo lần đầu)
model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
}

/// Thông báo trình duyệt (Web Push): loại tin, giờ yên lặng, mức chi tiết — áp dụng cho mọi thiết bị đã bật
model PushSettings {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kinds       Json
  quietStart  Int?
  quietEnd    Int?
  showDetails Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

/// Một thiết bị / trình duyệt đã cho phép nhận thông báo
model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String    @unique
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?

  @@index([userId])
}

/// Hàng đợi Web Push: mỗi thông báo tối đa một lần (gửi tới mọi thiết bị của người dùng)
model PushDelivery {
  id             String       @id @default(cuid())
  userId         String
  notificationId String       @unique
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  /// pending | sending | sent | failed | skipped
  status         String       @default("pending")
  attempts       Int          @default(0)
  lastError      String?
  nextAttemptAt  DateTime     @default(now())
  sentAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([status, nextAttemptAt])
  @@index([userId, sentAt])
}

/// Một danh mục / tài khoản của người dùng (TK chứng khoán, ví crypto, vàng cất nhà…). Mỗi người có ít nhất một
model Portfolio {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  transactions Transaction[]

  @@index([userId])
}

/// Một lượt tạo bản tin (sáng / chiều / tuần) cho một người và một kỳ. Khoá duy nhất theo kỳ để hai tiến trình
/// chạy cùng lúc hoặc chạy lại sau lỗi không tạo hai cuộc trò chuyện / hai thông báo cho cùng kỳ.
model BriefRun {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Trùng dedupeKey của thông báo, vd brief:weekly:2026-10-24
  key            String
  /// running | done
  status         String   @default("running")
  /// Lần nhận việc gần nhất; lượt "running" quá lâu coi như tiến trình đã chết và được nhận lại
  claimedAt      DateTime @default(now())
  /// Cuộc trò chuyện chứa bản tin, có ngay khi nội dung đã lưu — chạy lại thì dùng lại, không tạo mới
  conversationId String?
  /// Nội dung thông báo đã dựng, để chạy lại gửi đúng thông báo đó mà không gọi lại AI
  notification   Json?
  notificationId String?
  attempts       Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, key])
  @@index([conversationId])
}

/// Sự kiện đo hành vi (từ điển: src/analytics/events.ts). Không lưu nội dung chat, ghi chú, email hay giá trị danh mục.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  /// Người dùng đã đăng nhập; null với khách (dùng anonId)
  userId    String?
  /// Mã ngẫu nhiên của trình duyệt khách, không gắn với danh tính
  anonId    String?
  /// userId hoặc "anon:<anonId>" — dùng cho khoá chống trùng
  actor     String
  /// true khi phát từ danh mục mẫu (/demo), tách khỏi số liệu thật
  sample    Boolean  @default(false)
  props     Json     @default("{}")
  dedupeKey String?
  createdAt DateTime @default(now())

  @@unique([actor, dedupeKey])
  @@index([name, createdAt])
  @@index([userId, createdAt])
}

/// Một lần gọi model AI: token, chi phí ước tính và kết quả (AI-01). costUsd null = không rõ (thiếu usage hoặc
/// model chưa có trong bảng giá), không phải 0.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  /// chat | verifier | brief_morning | brief_closing | brief_weekly | alert | news_tag | plan_draft | eval
  feature          String
  model            String
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  costUsd          Decimal? @db.Decimal(14, 6)
  /// Phiên bản bảng giá dùng để tính costUsd
  priceVersion     String?
  durationMs       Int
  /// ok | error | aborted | refused
  outcome          String
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

/// Lượt dùng AI do người dùng bấm (một câu hỏi chat, một lần gửi thử bản tin, một bản nháp kế hoạch): giữ chỗ
/// trước khi gọi model để kiểm tra quota và số lượt chạy đồng thời một cách nguyên tử.
model AiRequest {
  id         String    @id @default(cuid())
  userId     String
  /// chat | brief_test | plan_draft
  kind       String
  /// running | done
  status     String    @default("running")
  createdAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([userId, kind, createdAt])
}

/// Hàng đợi tạo bản tin chạy nền: mỗi người / kỳ một việc; worker lấy việc bằng FOR UPDATE SKIP LOCKED, thử lại có
/// giãn cách, việc đang chạy dở khi server tắt được nhận lại. Chống trùng nội dung vẫn do BriefRun đảm nhiệm.
model BriefJob {
  id          String    @id @default(cuid())
  userId      String
  /// morning | closing | weekly | crypto (coin: day = giờ của kỳ, YYYY-MM-DDTHH)
  kind        String
  /// Ngày của kỳ (giờ VN) — chạy lại / thử lại vẫn tạo bản tin cho đúng kỳ này
  day         String
  /// queued | running | done | failed | skipped
  status      String    @default("queued")
  attempts    Int       @default(0)
  maxAttempts Int       @default(4)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  /// Kết quả: sent | nothing (không có gì để gửi) | duplicate (kỳ này đã có bản tin)
  result      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  finishedAt  DateTime?

  @@unique([userId, kind, day])
  @@index([status, runAfter])
}

/// Gợi ý sự kiện quyền người dùng đã chọn bỏ qua (vd đã tính vào số dư khai báo, hoặc nhận ở tài khoản khác)
model DismissedAction {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// danh mục:mã:loại:ngày GDKHQ (actionKey)
  key       String
  createdAt DateTime @default(now())

  @@id([userId, key])
}

/// Cài đặt nhắc lịch sự kiện quyền (GDKHQ, đại hội) theo người dùng; chưa có dòng = tắt, nhắc trước 1 ngày
model EventReminderSetting {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enabled      Boolean  @default(false)
  /// Nhắc trước bao nhiêu ngày lịch (1 hoặc 3)
  daysBefore   Int      @default(1)
  /// Mã không muốn nhận nhắc
  mutedSymbols String[] @default([])
  updatedAt    DateTime @updatedAt
}

/// Bộ lọc cổ phiếu người dùng đã lưu. filters/sort giữ đúng dạng gửi lên /screener/run (đã kiểm tra khi lưu); tối đa 20 / người
model SavedScreen {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  filters   Json
  sort      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt])
}

/// Tài khoản luyện tập bằng tiền ảo (FREE-07): tách hẳn khỏi danh mục thật (Holding/Transaction). Mỗi người một tài khoản
model PaperAccount {
  id        String       @id @default(cuid())
  userId    String       @unique
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startCash Decimal      @db.Decimal(30, 2)
  cash      Decimal      @db.Decimal(30, 2)
  startedAt DateTime     @default(now())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  trades    PaperTrade[]
}

/// Lệnh giả lập đã khớp. Vị thế được suy ra từ các lệnh này (bình quân giá vốn), không lưu riêng
model PaperTrade {
  id          String       @id @default(cuid())
  accountId   String
  account     PaperAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// 'stock' | 'crypto'
  assetType   String
  /// Mã cổ phiếu, hoặc cặp coin dạng BTCUSDT
  symbol      String
  /// 'buy' | 'sell'
  side        String
  quantity    Decimal      @db.Decimal(30, 10)
  /// VND / đơn vị tại lúc khớp
  price       Decimal      @db.Decimal(30, 10)
  priceSource String
  fee         Decimal      @db.Decimal(30, 2)
  tax         Decimal      @db.Decimal(30, 2)
  cashAfter   Decimal      @db.Decimal(30, 2)
  executedAt  DateTime     @default(now())

  @@index([accountId, executedAt])
}

/// Bộ nhớ đệm dữ liệu thị trường (không phải thời gian thực), bền qua lần khởi động lại. Khoá có không gian tên và phiên bản,
/// vd. `vietcap:v1:ratios:FPT`; đổi cách ánh xạ dữ liệu thì tăng phiên bản để bỏ qua bản cũ.
model MarketCache {
  key        String   @id
  /// Giá trị đã chuẩn hoá thành JSON (giới hạn kích thước ở tầng service)
  value      Json
  /// Nguồn dữ liệu, vd. 'vietcap'
  source     String
  fetchedAt  DateTime
  /// Hết hạn "còn mới": sau mốc này phải tải lại
  expiresAt  DateTime
  /// Hết hạn "dùng tạm khi nguồn lỗi": sau mốc này dòng bị dọn
  staleUntil DateTime

  @@index([staleUntil])
}

/// Nhịp tim của tiến trình worker (một dòng mỗi worker): web và bước kiểm tra sau deploy đọc để biết worker còn chạy
model WorkerHeartbeat {
  name      String   @id
  /// Lúc tiến trình này khởi động (đổi mỗi lần worker khởi động lại)
  startedAt DateTime
  beatAt    DateTime
  version   String
}

/// Cảnh báo theo tình trạng danh mục (FREE-09): mỗi người tối đa một dòng cho mỗi loại, mặc định tắt
model PortfolioAlertRule {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// concentration | drift | drawdown
  kind         String
  enabled      Boolean  @default(false)
  /// concentration: % tổng tài sản; drift: điểm % lệch; drawdown: % giảm từ đỉnh
  thresholdPct Float
  /// drawdown: số ngày nhìn lại để tìm đỉnh
  windowDays   Int?
  /// drift: tỷ trọng mục tiêu theo nhóm, vd {"stock":55,"crypto":5,"gold":15,"cash":25}
  targets      Json?
  /// Nhắc lại tối đa mỗi N ngày khi tình trạng vẫn còn
  cooldownDays Int      @default(3)
  /// Kết quả lần kiểm tra gần nhất {at, status, title, reason} (worker ghi; trang Hôm nay đọc cho quy tắc giảm từ đỉnh)
  lastCheck    Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, kind])
  @@index([enabled])
}

/// Soi lời khuyên: tin "hô mã" người dùng dán vào, lời khuyên bóc tách, phiếu kiểm chứng, quyết định và kết quả chấm lại.
/// Kế hoạch / cảnh báo tạo từ phiếu chỉ lưu id (không khoá ngoại) để xoá chúng không bị chặn.
model TipCheck {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tin gốc (tối đa 4.000 ký tự)
  text             String
  /// Tên nguồn do người dùng ghi, vd "Nhóm VIP anh T"; thống kê theo nguồn gộp theo chữ thường
  sourceName       String?
  /// zalo | telegram | facebook | broker | friend | other
  sourceKind       String?
  /// stock | crypto
  assetType        String
  /// HPG, BTCUSDT
  symbol           String
  /// Lời khuyên bóc tách: direction, targetPrice, stopPrice, horizonDays, reasons, promises, citesSource, candidates
  claims           Json
  /// Số tiền giả định (VND) người dùng nhập; null = app tự giả định
  amountVnd        Float?
  /// Giá lúc soi theo đơn vị gốc (VND/cp, USDT/coin)
  priceAtCheck     Float?
  priceSource      String?
  /// VNINDEX | BTC
  benchmark        String?
  benchmarkAtCheck Float?
  /// Mức nóng 0–100 và từng phần cộng điểm (kèm số liệu lúc soi)
  score            Int?
  scoreParts       Json?
  /// Với riêng bạn: tỷ trọng, lỗ nếu cắt lỗ, đang giữ, kế hoạch, tiền mặt
  personal         Json?
  /// Phần đọc dữ liệu: dataSays, missing, unverifiable, verdict, questions, sources, trạng thái AI
  report           Json?
  /// extracted | analyzed
  status           String    @default("extracted")
  /// ignore | watch | plan | practice
  decision         String?
  decidedAt        DateTime?
  /// Mua thật mã này trong 7 ngày sau khi soi (tự phát hiện từ sổ)
  boughtAt         DateTime?
  planId           String?
  priceAlertId     String?
  conversationId   String?
  /// Kết quả chấm lại sau 30 / 90 ngày
  review30         Json?
  review90         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
